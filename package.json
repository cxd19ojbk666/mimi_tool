{
  "name": "mimi-toolbox",
  "version": "1.0.0",
  "description": "咪咪大王工具箱：排座位与做板贴",
  "main": "src/main/main.js",
  "author": "咪的汪",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dmg zip --arm64",
    "build:win": "electron-builder --win nsis portable --x64",
    "build": "npm run build:mac && npm run build:win"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mimi.toolbox",
    "productName": "咪咪大王工具箱",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/main.js",
      "src/renderer/index.html",
      "src/renderer/pages/*.html",
      "src/renderer/styles/*.css",
      "src/renderer/scripts/*.js",
      "assets/mimi-toolbox-icon-1024.png",
      "assets/mimi-toolbox-transparent.ico"
    ],
    "mac": {
      "icon": "assets/mimi-toolbox.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "咪咪大王工具箱 ${version}",
      "artifactName": "咪咪大王工具箱-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "assets/mimi-toolbox.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "咪咪大王工具箱-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "咪咪大王工具箱"
    },
    "portable": {
      "artifactName": "咪咪大王工具箱-${version}-${arch}-portable.${ext}"
    }
  }
}
